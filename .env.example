# Examples only. Supply your own values; never commit .env.
DATABASE_URL=postgresql://accord:replace-local-password@localhost:5432/accord
# Compose only: use long random URL-safe passwords (these are placeholders).
POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_LOCAL_DATABASE_PASSWORD
APP_DB_PASSWORD=replace-with-another-24-random-url-safe-characters
APP_ORIGIN=https://localhost:8443
PUBLIC_DEPLOYMENT=false
SESSION_SECURE=true
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=replace-with-sandbox-client-id
PAYPAL_CLIENT_SECRET=replace-with-sandbox-secret
PAYPAL_MERCHANT_ID=replace-with-supplier-merchant-id
PAYPAL_WEBHOOK_ID=replace-with-registered-webhook-id
FAULT_DROP_CAPTURE_RESPONSE=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-2025-04-14
# Set gemini explicitly to use a Gemini Free-tier project with billing disabled.
EXTRACTION_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Operator-only acceptance bootstrap. Keep these out of web/worker containers.
BUYER_PAYER_ID=
# Existing PAYPAL_BUYER_PAYER_ID is accepted as an alias by acceptance tools.
ACCORD_BUYER_USERNAME=buyer
ACCORD_SUPPLIER_USERNAME=supplier
ACCORD_BUYER_PASSWORD=
ACCORD_SUPPLIER_PASSWORD=
# Optional separate owner credential for migrations/seed; never give to the API.
ACCORD_OWNER_DATABASE_URL=
